# Supabase baglantisi
# Degerleri Supabase panelinde: Project Settings -> API bolumunde bulursun.
#
# Bu dosyayi kopyalayip ".env" adiyla kaydet ve degerleri doldur:
#   cp .env.example .env
#
# .env dosyasi .gitignore icinde, repoya gitmez.
# Netlify tarafinda ayni iki degiskeni Site settings -> Environment variables
# bolumune eklemen gerekir.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
